# Somente desenvolvimento local. Gere .env com scripts/init-env.sh.
COMPOSE_PROJECT_NAME=flow
FLOW_ENV=development
HOST_BIND=127.0.0.1
API_PORT=18080
POSTGRES_PORT=15432
REDIS_PORT=16379
RABBITMQ_PORT=15672
RABBITMQ_MANAGEMENT_PORT=15673
POSTGRES_DB=flow
POSTGRES_USER=flow
POSTGRES_PASSWORD=
REDIS_PASSWORD=
RABBITMQ_USER=flow
RABBITMQ_PASSWORD=
HTTP_MAX_BODY_BYTES=1048576
DEPENDENCY_TIMEOUT=2s
SHUTDOWN_TIMEOUT=10s
OTEL_EXPORTER_OTLP_ENDPOINT=
# Identidade: chave local gerada por make env; produção usa secret manager.
IDENTITY_HMAC_KEY=
AUTH_ACCESS_TTL=10m
AUTH_SESSION_TTL=720h
AUTH_CHALLENGE_TTL=5m
AUTH_RECENT_AUTH=5m
AUTH_RESEND_COOLDOWN=60s
AUTH_OTP_ATTEMPTS=5
AUTH_MAX_SESSIONS=10
AUTH_ORIGIN_MINUTE=60
SMS_ALLOWED_REGIONS=BR
SMS_NUMBER_HOUR=3
SMS_ORIGIN_HOUR=5
SMS_GLOBAL_MINUTE=10
SMS_GLOBAL_DAY=100
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
