# Somente desenvolvimento local. Gere .env com scripts/init-env.sh.
COMPOSE_PROJECT_NAME=flow
FLOW_ENV=development
HOST_BIND=127.0.0.1
API_PORT=18080
POSTGRES_PORT=15432
REDIS_PORT=16379
RABBITMQ_PORT=15672
RABBITMQ_MANAGEMENT_PORT=15673
POSTGRES_DB=flow
POSTGRES_USER=flow
POSTGRES_PASSWORD=
REDIS_PASSWORD=
RABBITMQ_USER=flow
RABBITMQ_PASSWORD=
HTTP_MAX_BODY_BYTES=1048576
DEPENDENCY_TIMEOUT=2s
SHUTDOWN_TIMEOUT=10s
OTEL_EXPORTER_OTLP_ENDPOINT=
# Identidade: chave local gerada por make env; produção usa secret manager.
IDENTITY_HMAC_KEY=
AUTH_ACCESS_TTL=10m
AUTH_SESSION_TTL=720h
AUTH_CHALLENGE_TTL=5m
AUTH_RECENT_AUTH=5m
AUTH_RESEND_COOLDOWN=60s
AUTH_OTP_ATTEMPTS=5
AUTH_MAX_SESSIONS=10
AUTH_ORIGIN_MINUTE=60
SMS_ALLOWED_REGIONS=BR
# Temporary local phone access. Never enable in production; values stay server-side.
AUTH_DEVELOPMENT_PHONE_ENABLED=false
AUTH_DEVELOPMENT_PHONE_NUMBER=
AUTH_DEVELOPMENT_SMS_CODE=
SMS_NUMBER_HOUR=3
SMS_ORIGIN_HOUR=5
SMS_GLOBAL_MINUTE=10
SMS_GLOBAL_DAY=100
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
GOOGLE_CLIENT_IDS=
APPLE_CLIENT_IDS=
# Experiences: quotas por conta/dia UTC; catálogo vive no PostgreSQL.
EXPERIENCES_CREATE_DAILY=20
EXPERIENCES_PUBLISH_DAILY=20
EXPERIENCES_UPLOAD_DAILY=30
EXPERIENCES_MAX_DRAFTS=50
HOME_SOON_HOURS=48
HOME_RADIUS_M=25000
HOME_SECTION_LIMIT=6
RADAR_RESULT_LIMIT=100
RADAR_MIN_ZOOM=4
RADAR_MAX_SPAN_DEGREES=30
# S3 privado local. Para nuvem: HTTPS, credencial restrita e bucket provisionado.
S3_PORT=18333
MEDIA_S3_ENDPOINT=http://storage:8333
MEDIA_S3_PUBLIC_ENDPOINT=http://127.0.0.1:18333
MEDIA_S3_REGION=us-east-1
MEDIA_S3_BUCKET=flow-covers
MEDIA_S3_ACCESS_KEY=
MEDIA_S3_SECRET_KEY=
MEDIA_S3_SESSION_TOKEN=

# PR-05: Flows, limites verificados também pelo worker Go/FFmpeg.
FLOWS_WINDOW_HOURS=48
PARTICIPATION_MUTATION_MINUTE=30
CHECKIN_TTL_SECONDS=120
CHECKIN_LEAD_MINUTES=30
FLOW_MEDIA_MAX_BYTES=33554432
FLOW_MEDIA_MAX_DIMENSION=1920

# PR-07 Social. Operator DB credential is separate and never injected in the API.
SOCIAL_BODY_LIMIT=3000
SOCIAL_MEDIA_LIMIT=4
SOCIAL_MUTATION_MINUTE=30
SOCIAL_EDIT_HOURS=24
