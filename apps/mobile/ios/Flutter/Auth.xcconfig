// The default keeps Apple capability for properly provisioned program teams.
FLOW_CODE_SIGN_ENTITLEMENTS = Runner/Runner.entitlements
FLOW_IOS_BUNDLE_IDENTIFIER = com.example.flowMobile
#include? "Auth.local.xcconfig"
