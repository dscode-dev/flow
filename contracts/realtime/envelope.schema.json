{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:flow:realtime:envelope:v1",
  "title": "Convenção futura, sem servidor WebSocket no PR-00",
  "type": "object",
  "additionalProperties": false,
  "required": ["message_id", "type", "version", "sent_at", "payload"],
  "properties": {
    "message_id": {"type": "string", "format": "uuid"},
    "type": {"type": "string", "maxLength": 150},
    "version": {"type": "integer", "minimum": 1},
    "sent_at": {"type": "string", "format": "date-time"},
    "correlation_id": {"type": "string", "maxLength": 64},
    "payload": {"type": "object"}
  }
}
